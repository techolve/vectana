{
  "name": "@techolve/vectana-mcp",
  "version": "1.1.0",
  "description": "MCP server (stdio) for Vectana: vulnerabilities, EOL, SBOM import, projects, customers and estimates",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "vectana-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techolve/vectana.git",
    "directory": "mcp"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "gen:types": "openapi-typescript ${VECTANA_OPENAPI:-../api/openapi.json} -o src/api-types.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
