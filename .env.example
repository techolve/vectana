# Copy to .env (production: next to compose.prod.yaml)
# Docker Hub image (Private)
VECTANA_IMAGE=heki0824/vectana
VECTANA_VERSION=0.1.5
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
SECRET_KEY=
WEB_URL=https://vectana.example.com
GROUP_NAME=Vectana Group
SCAN_INTERVAL_MINUTES=360

# Mail: smtp | cloudflare | none
MAIL_BACKEND=smtp
MAIL_FROM=Vectana <vectana@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
